{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pipeline A eval labels",
  "description": "Ground truth for the ~50-photo hand-tuning set (AI_PIPELINES.md Pipeline A).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "gcsUri", "contextText", "expected"],
    "properties": {
      "id": { "type": "string", "description": "Short unique id, e.g. 'photo-014'." },
      "gcsUri": { "type": "string", "pattern": "^gs://", "description": "Where the photo actually lives." },
      "contextText": {
        "type": "string",
        "description": "The structured context block as it would really be assembled (nearest monitor AQI, satellite aerosol index, time of day, season) -- see AI_PIPELINES.md 'Input assembly'. Use realistic values, not placeholders, once you have them."
      },
      "expected": {
        "type": "object",
        "required": ["sourceClassification"],
        "properties": {
          "sourceClassification": {
            "type": "string",
            "enum": [
              "crop_residue_burning",
              "industrial_emission",
              "open_waste_burning",
              "vehicular_smog",
              "construction_dust",
              "no_visible_pollution",
              "indeterminate"
            ]
          },
          "severityEstimate": { "type": "integer", "minimum": 1, "maximum": 5 },
          "needsHumanReview": { "type": "boolean" }
        }
      },
      "notes": { "type": "string", "description": "Why this example is in the set -- e.g. 'backlit, tests calibration rule 1'." }
    }
  }
}
