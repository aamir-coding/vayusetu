# alert-service -- local development against the Firebase/Pub/Sub emulators.
# Copy to .env and run with:  pnpm --filter @vayusetu/alert-service dev
# (tsx doesn't auto-load .env; use `node --env-file=.env` or export these.)

# MUST match submission-service + infra/scripts/dev-emulators.sh -- emulator data is namespaced per project ID.
GOOGLE_CLOUD_PROJECT=vayusetu-ncr-dev
PORT=8082
NODE_ENV=development

# Officials' REST auth. mock = admin-dashboard personas (mock-token:mock-deshmukh / mock-iyer)
AUTH_MODE=mock

# Pub/Sub push auth. The emulator sends no OIDC token, so 'off' locally.
# Production (set by Terraform): oidc + audience + push SA email.
PUBSUB_PUSH_AUTH=off
# PUBSUB_PUSH_AUDIENCE=vayusetu-alert-service-ncr-dev
# PUBSUB_PUSH_SA_EMAIL=pubsub-push-ncr-dev@<project>.iam.gserviceaccount.com

# FCM has no emulator. 'stub' logs pushes; set 'live' only with real ADC for a real project.
PUSH_CHANNEL_MODE=stub
SMS_CHANNEL_MODE=stub
WHATSAPP_CHANNEL_MODE=stub

DASHBOARD_BASE_URL=http://localhost:5174
HOTSPOT_SEVERITY_THRESHOLDS=0.6,0.75,0.9
SUPPRESSION_WINDOW_HOURS=24

# Unset => every cell resolves to the defaults below (fine for local dev).
# GOOGLE_MAPS_API_KEY=
DEFAULT_STATE_CODE=DL
DEFAULT_DISTRICT_CODE=DL-CENTRAL

FIRESTORE_EMULATOR_HOST=localhost:8081
PUBSUB_EMULATOR_HOST=localhost:8085
