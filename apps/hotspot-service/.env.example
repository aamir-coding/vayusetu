GOOGLE_CLOUD_PROJECT=vayusetu-ncr-dev
NODE_ENV=development
PORT=8086
AUTH_MODE=mock
PUBSUB_PUSH_AUTH=off
FIRESTORE_EMULATOR_HOST=localhost:8081
PUBSUB_EMULATOR_HOST=localhost:8085
# heuristic | endpoint (HOTSPOT_ENDPOINT_ID) | batch (HOTSPOT_MODEL)
HOTSPOT_SCORER=heuristic

