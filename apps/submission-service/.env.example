# Copy to .env.local for local development.
#
# AUTH_MODE=mock lets this service run WITHOUT a real Firebase project by
# accepting the same `mock-token:<uid>` scheme apps/citizen-pwa's MSW mocks
# already use (see apps/citizen-pwa/src/mocks/fixtures.ts#extractUid) --
# so Engineer 1's frontend can point VITE_API_BASE_URL at this real
# service early, before Firebase Auth is wired end-to-end. index.ts
# refuses to boot with AUTH_MODE=mock when NODE_ENV=production.
AUTH_MODE=mock

NODE_ENV=development
PORT=8080

# Required even with AUTH_MODE=mock -- the Firestore/Pub-Sub clients need
# a project id to target (the emulators use it as a namespace, not a real
# GCP project). Use the id from infra/terraform/environments/ncr/terraform.tfvars.
GOOGLE_CLOUD_PROJECT=vayusetu-ncr-dev

# Point these at the local emulators (infra/scripts/dev-emulators.sh)
# rather than real GCP while developing:
FIRESTORE_EMULATOR_HOST=localhost:8081
PUBSUB_EMULATOR_HOST=localhost:8085

# Optional. Without this, resolveJurisdiction() falls back to
# DEFAULT_STATE_CODE/DEFAULT_DISTRICT_CODE below instead of calling the
# real Geocoding API -- fine for local dev, required before any real pilot.
GOOGLE_MAPS_API_KEY=

DEFAULT_STATE_CODE=DL
DEFAULT_DISTRICT_CODE=DL-CENTRAL

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
