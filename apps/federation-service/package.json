{
  "name": "@vayusetu/federation-service",
  "version": "0.1.0",
  "private": true,
  "description": "VayuSetu Federation Exchange -- nightly Cloud Run Job (k-anonymized hotspot summaries + Model Registry publish/pull to the National Exchange) and the Federation REST endpoints from API_CONTRACTS.md 4.2.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
