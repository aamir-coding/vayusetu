# federation-service -- local dev against the Firestore emulator.
# HTTP API:     node --env-file=.env --import tsx src/index.ts
# Nightly job:  node --env-file=.env --import tsx src/jobs/nightlySync.ts
# The job and the import endpoint talk to REAL BigQuery + Vertex AI in the
# exchange project (neither has an emulator) -- see WEEK3_SETUP.md.

# MUST match the other services + infra/scripts/dev-emulators.sh (emulator data is per project).
GOOGLE_CLOUD_PROJECT=vayusetu-ncr-dev
PORT=8083
NODE_ENV=development
AUTH_MODE=mock

FEDERATION_STATE_CODE=DL
FEDERATION_OWNED_STATES=DL,HR,UP,RJ
EXCHANGE_PROJECT_ID=vayusetu-national-exchange
EXCHANGE_DATASET=federation_exchange
BIGQUERY_LOCATION=asia-south1
VERTEX_LOCATION=asia-south1

K_MIN_CONTRIBUTORS=10
K_MIN_REPORTS=10
GENERALIZED_H3_RESOLUTION=6
FEATURE_SCHEMA_VERSIONS=hotspot=hs-v1,forecast=fc-v1
SUMMARY_LOOKBACK_WEEKS=4

FIRESTORE_EMULATOR_HOST=localhost:8081
