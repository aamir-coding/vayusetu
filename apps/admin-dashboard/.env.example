# Copy to .env.local once Engineer 2's Terraform + alert-service exist.
# With none of these set the dashboard runs fully in mock mode: MSW
# intercepts every API call, and sign-in accepts any email and fabricates
# a district_admin session for NCR/Delhi (custom claims are normally set
# server-side by a super_admin per API_CONTRACTS.md — there's no real
# provisioning flow to call here yet, so mock mode stands in for it).

# --- Backend ---
# Mock mode (MSW) is ON by default in `pnpm dev`. To use real services:
#   VITE_USE_MOCKS=false  -> /api/v1/* is proxied per packages/config/api-routes.json
#   (submission-service :8080, alert-service :8082, federation :8083,
#    hotspot :8086, forecast :8087). Leave VITE_API_BASE_URL unset so
#   calls stay same-origin, exactly like Firebase Hosting in production.
VITE_USE_MOCKS=true
# VITE_API_BASE_URL=/api/v1

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
