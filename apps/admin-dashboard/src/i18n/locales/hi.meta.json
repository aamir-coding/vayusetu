    "text": "उत्पादन में आयात करना केवल सुपर_एडमिन के अधिकार क्षेत्र में है (यह सबसे अधिक प्रभाव डालने वाली कार्रवाई है)।"
  },
  "federation.imported": {
    "sourceHash": "67a4ec46266bcd28",
    "text": "मॉडल आयातित और सक्रिय किया गया"
  },
  "federation.importBlocked": {
    "sourceHash": "9de10faf69fad6ee",
    "text": "आयात अवरुद्ध"
  },
  "federation.postRequest": {
    "sourceHash": "b421ea78b90910db",
    "text": "संसाधन अनुरोध पोस्ट करें"
  },
  "federation.resourceType": {
    "sourceHash": "c9bf2e8987cca1e2",
    "text": "संसाधन प्रकार"
  },
  "federation.quantity": {
    "sourceHash": "822bab8d41bca8d7",
    "text": "मात्रा"
  },
  "federation.post": {
    "sourceHash": "72fb5fa0ce8fba16",
    "text": "पोस्ट अनुरोध"
  },
  "federation.posted": {
    "sourceHash": "712f670d9fc37354",
    "text": "संसाधन अनुरोध पोस्ट किया गया"
  },
  "federation.weekSummary": {
    "sourceHash": "936bec45205fe7dc",
    "text": "{{week}} का सप्ताह · { {{states}} {{cells}} सामान्यीकृत कोशिकाएं (res 6)"
  },
  "federation.exchangeIntro": {
    "sourceHash": "1b8596acd035245e",
    "text": "एक्सचेंज पर मौजूद प्रत्येक राज्य से साप्ताहिक k-अनाम सारांश"
  },
  "federation.noSummaries": {
    "sourceHash": "7c4f2015935d0d61",
    "text": "इस क्षेत्र के लिए अभी तक कोई साझा सारांश उपलब्ध नहीं है।"
  },
  "federation.noSummariesHint": {
    "sourceHash": "83d4ce30e48161e2",
    "text": "पर्याप्त नागरिकों द्वारा रिपोर्ट किए जाने के बाद (k-अनाम पहचान सीमा), राज्य पिछले सप्ताह के कुल आंकड़े रात में प्रकाशित करते हैं।"
  },
  "federation.byState": {
    "sourceHash": "952cdc555426e478",
    "text": "राज्य के योगदान से"
  },
  "federation.byStateHint": {
    "sourceHash": "a2b2c8d12da90c43",
    "text": "नवीनतम सप्ताह के सेल औसत का माध्य"
  },
  "federation.stateCells": {
    "sourceHash": "fcf3103acfd219a5",
    "text": "{{count}} कोशिकाएँ · {{pct}} %"
  },
  "federation.gateMetric": {
    "sourceHash": "7d2ef2a202346824",
    "text": "गुणवत्ता द्वार"
  },
  "federation.moreMetrics": {
    "sourceHash": "7ecd4b9854acd844",
    "text": "{{count}} और मेट्रिक्स"
  },
  "theme.toDark": {
    "sourceHash": "9b7878aef90b527c",
    "text": "डार्क मोड"
  },
  "theme.toLight": {
    "sourceHash": "b4fcfbee4fb937d7",
    "text": "लाइट मोड"
  },
  "tour.next": {
    "sourceHash": "1ff57a29d7c9d11b",
    "text": "अगला"
  },
  "tour.back": {
    "sourceHash": "76900f1bfd16c8d4",
    "text": "पीछे"
  },
  "tour.done": {
    "sourceHash": "5ad3dbd1242a4cea",
    "text": "समझ गया"
  },
  "tour.skip": {
    "sourceHash": "5ac614dee51bcf6a",
    "text": "दौरे को छोड़ें"
  },
  "tour.welcomeTitle": {
    "sourceHash": "22973e1f89c3623f",
    "text": "स्वागत है, {{name}}"
  },
  "tour.welcomeBody": {
    "sourceHash": "652ac36d08c3a1a8",
    "text": "आपके कंसोल का एक मिनट का संक्षिप्त परिचय: अलर्ट कहाँ आते हैं, उन पर कैसे कार्रवाई करें और भविष्य की योजना कैसे बनाएं।"
  },
  "tour.alertsBody": {
    "sourceHash": "879215142e1090a1",
    "text": "आपके अधिकार क्षेत्र के लिए प्रदूषण संबंधी नई चेतावनियाँ यहाँ तुरंत उपलब्ध होती हैं, सबसे ज़रूरी चेतावनियाँ पहले। जानकारी पढ़ने के लिए एक चेतावनी खोलें, फिर आगे बढ़ें: स्वीकार करें, प्रगति पर, हल हो गया। हर कदम रिकॉर्ड किया जाता है।"
  },
  "tour.hotspotsBody": {
    "sourceHash": "841c103335694346",
    "text": "हर घंटे पड़ोस के हर सेल में प्रदूषण का स्तर मापा जाता है। लाल रंग वाले सेल पर ध्यान देने की जरूरत है; एम्बर रंग की आउटलाइन किसी छिपे हुए हॉटस्पॉट को दर्शाती है जो किसी भी मॉनिटर से दूर है। सिग्नल और 7 दिन का इतिहास देखने के लिए सेल पर टैप करें।"
  },
  "tour.forecastBody": {
    "sourceHash": "7564776351668afa",
    "text": "अगले 72 घंटों के लिए वायु गुणवत्ता की स्थिति, जिसमें जीआरएपी चरण भी शामिल है, इसलिए प्रतिबंध चरम सीमा से पहले ही शुरू किए जा सकते हैं।"
  },
  "tour.federationBody": {
    "sourceHash": "aaab926ddc806824",
    "text": "अन्य राज्यों के रुझानों की तुलना करें और उनके द्वारा साझा किए गए मॉडलों को अपनाएं। केवल सारांश ही साझा किए जाते हैं; नागरिकों की रिपोर्टें कभी भी आपके राज्य से बाहर नहीं जातीं।"
  },
  "tour.pushTitle": {
    "sourceHash": "81af1dba0ff62460",
    "text": "यह टैब बंद होने पर भी अलर्ट प्राप्त करें"
  },
  "tour.pushBody": {
    "sourceHash": "63f00babe26c3069",
    "text": "अलर्ट नोटिफिकेशन चालू करें ताकि कोई नया हॉटस्पॉट आने पर आपको तुरंत इस डिवाइस पर सूचना मिल जाए।"
  },
  "tour.helpTitle": {
    "sourceHash": "607106a1f515566f",
    "text": "मदद हमेशा उपलब्ध है"
  },
  "tour.helpBody": {
    "sourceHash": "97758818708ca9a3",
    "text": "इस टूर को दोबारा देखें, भाषा या थीम बदलें और यहां से साइन आउट करें।"
  }
}
