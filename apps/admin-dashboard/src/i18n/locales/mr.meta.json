    "text": "प्रोडक्शनमध्ये इम्पोर्ट करणे केवळ सुपर_अ‍ॅडमिनसाठी आहे (सर्वाधिक-ब्लास्ट-त्रिज्येची क्रिया)."
  },
  "federation.imported": {
    "sourceHash": "67a4ec46266bcd28",
    "text": "मॉडेल आयात करून सक्रिय केले."
  },
  "federation.importBlocked": {
    "sourceHash": "9de10faf69fad6ee",
    "text": "आयात अवरोधित"
  },
  "federation.postRequest": {
    "sourceHash": "b421ea78b90910db",
    "text": "संसाधनाची विनंती पोस्ट करा"
  },
  "federation.resourceType": {
    "sourceHash": "c9bf2e8987cca1e2",
    "text": "संसाधन प्रकार"
  },
  "federation.quantity": {
    "sourceHash": "822bab8d41bca8d7",
    "text": "प्रमाण"
  },
  "federation.post": {
    "sourceHash": "72fb5fa0ce8fba16",
    "text": "पोस्ट विनंती"
  },
  "federation.posted": {
    "sourceHash": "712f670d9fc37354",
    "text": "संसाधनासाठी विनंती नोंदवली आहे."
  },
  "federation.weekSummary": {
    "sourceHash": "936bec45205fe7dc",
    "text": "{{week}} चा आठवडा · {{cells}} सामान्यीकृत पेशी (res 6) {{states}} राज्यांमध्ये"
  },
  "federation.exchangeIntro": {
    "sourceHash": "1b8596acd035245e",
    "text": "एक्सचेंजवरील प्रत्येक राज्यातून साप्ताहिक के-अनामिक सारांश"
  },
  "federation.noSummaries": {
    "sourceHash": "7c4f2015935d0d61",
    "text": "या क्षेत्रासाठी अद्याप कोणतेही सामायिक सारांश नाहीत."
  },
  "federation.noSummariesHint": {
    "sourceHash": "83d4ce30e48161e2",
    "text": "पुरेशा नागरिकांनी अहवाल दिल्यानंतर (के-अनामिकतेची किमान मर्यादा), राज्ये दररोज रात्री मागील आठवड्याची एकत्रित आकडेवारी प्रकाशित करतात."
  },
  "federation.byState": {
    "sourceHash": "952cdc555426e478",
    "text": "राज्याचे योगदान देऊन"
  },
  "federation.byStateHint": {
    "sourceHash": "a2b2c8d12da90c43",
    "text": "सेल सरासरींची सरासरी, नवीनतम आठवडा"
  },
  "federation.stateCells": {
    "sourceHash": "fcf3103acfd219a5",
    "text": "{{count}} पेशी · {{pct}} %"
  },
  "federation.gateMetric": {
    "sourceHash": "7d2ef2a202346824",
    "text": "गुणवत्ता गेट"
  },
  "federation.moreMetrics": {
    "sourceHash": "7ecd4b9854acd844",
    "text": "अधिक मेट्रिक्स {{count}}"
  },
  "theme.toDark": {
    "sourceHash": "9b7878aef90b527c",
    "text": "डार्क मोड"
  },
  "theme.toLight": {
    "sourceHash": "b4fcfbee4fb937d7",
    "text": "प्रकाश मोड"
  },
  "tour.next": {
    "sourceHash": "1ff57a29d7c9d11b",
    "text": "पुढील"
  },
  "tour.back": {
    "sourceHash": "76900f1bfd16c8d4",
    "text": "मागे"
  },
  "tour.done": {
    "sourceHash": "5ad3dbd1242a4cea",
    "text": "समजलं."
  },
  "tour.skip": {
    "sourceHash": "5ac614dee51bcf6a",
    "text": "दौरा वगळा"
  },
  "tour.progress": {
    "sourceHash": "487fcaf37ab97ea0",
    "text": "{{total}} पैकी {{current}}"
  },
  "tour.welcomeTitle": {
    "sourceHash": "22973e1f89c3623f",
    "text": "स्वागत आहे, {{name}}"
  },
  "tour.welcomeBody": {
    "sourceHash": "652ac36d08c3a1a8",
    "text": "तुमच्या कन्सोलचा एक मिनिटाचा आढावा: सूचना कोठे येतात, त्यावर कशी कारवाई करावी आणि पुढे काय पाहावे."
  },
  "tour.alertsBody": {
    "sourceHash": "879215142e1090a1",
    "text": "तुमच्या कार्यक्षेत्रासाठीचे नवीन प्रदूषण अलर्ट येथे थेट येतात, सर्वात तातडीचे अलर्ट प्रथम येतात. माहिती वाचण्यासाठी एक अलर्ट उघडा, आणि मग त्याला पुढे न्या: स्वीकारा, प्रगतीपथावर, निराकरण झाले. प्रत्येक टप्प्याची नोंद ठेवली जाते."
  },
  "tour.hotspotsBody": {
    "sourceHash": "841c103335694346",
    "text": "प्रत्येक तासाला परिसरातील प्रत्येक सेलच्या प्रदूषणाची नोंद ठेवली जाते. लाल रंगाच्या सेलकडे लक्ष देण्याची गरज आहे; पिवळसर रंगाची बाह्यरेषा कोणत्याही मॉनिटरपासून दूर असलेला एक छुपा हॉटस्पॉट दर्शवते. त्याचे सिग्नल आणि ७-दिवसांचा इतिहास पाहण्यासाठी सेलवर टॅप करा."
  },
  "tour.forecastBody": {
    "sourceHash": "7564776351668afa",
    "text": "पुढील ७२ तासांसाठी हवेची गुणवत्ता, आणि त्यावरून सूचित होणारी GRAP स्टेज, जेणेकरून उच्चांकापूर्वीच निर्बंध सुरू होऊ शकतील."
  },
  "tour.federationBody": {
    "sourceHash": "aaab926ddc806824",
    "text": "इतर राज्यांशी प्रवृत्तींची तुलना करा आणि त्यांनी सामायिक केलेले नमुने स्वीकारा. केवळ सारांश सामायिक केले जातात; नागरिकांचे अहवाल कधीही तुमच्या राज्याबाहेर जात नाहीत."
  },
  "tour.pushTitle": {
    "sourceHash": "81af1dba0ff62460",
    "text": "हा टॅब बंद असतानाही सूचना मिळवा"
  },
  "tour.pushBody": {
    "sourceHash": "63f00babe26c3069",
    "text": "अलर्ट नोटिफिकेशन्स चालू करा, जेणेकरून नवीन हॉटस्पॉट आल्यास तो तुम्हाला या डिव्हाइसवर लगेच मिळेल."
  },
  "tour.helpTitle": {
    "sourceHash": "607106a1f515566f",
    "text": "मदत नेहमीच उपलब्ध आहे."
  },
  "tour.helpBody": {
    "sourceHash": "97758818708ca9a3",
    "text": "ही टूर पुन्हा प्ले करा, भाषा किंवा थीम बदला आणि येथून साइन आउट करा."
  }
}
