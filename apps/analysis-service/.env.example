# Local dev: node --env-file=.env --import tsx src/index.ts
GOOGLE_CLOUD_PROJECT=vayusetu-ncr-dev
NODE_ENV=development
PORT=8088
# The Pub/Sub emulator sends no OIDC token.
PUBSUB_PUSH_AUTH=off
FIRESTORE_EMULATOR_HOST=localhost:8081
PUBSUB_EMULATOR_HOST=localhost:8085
# Optional -- each one switches a real Google API on (all read ADC):
# GOOGLE_MAPS_API_KEY=            # Air Quality API reference AQI
# ADVISORY_AUDIO_BUCKET=vayusetu-ncr-dev-advisory-audio   # Pipeline B (TTS)
# RAW_ARCHIVE_BUCKET=vayusetu-ncr-dev-model-artifacts     # raw model responses
# GEMINI_LOCATION=global
# GEMINI_TRIAGE_MODEL=gemini-3.7-flash
