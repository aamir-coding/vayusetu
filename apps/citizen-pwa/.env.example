# Copy to .env.local and fill in once Engineer 2's Terraform stands up the
# dev Firebase project + submission-service. With NONE of these set, the app
# runs fully in mock mode: MSW intercepts every API call and Firebase Auth
# is replaced by an in-memory mock (anonymous session, dev OTP = 123456) —
# see src/lib/firebase.ts and src/mocks/. This is intentional: frontend work
# is never blocked on backend readiness (Week 1 goal).

# --- submission-service base URL (falls back to a same-origin mock path) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Firebase project config (Firebase Console → Project settings) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Optional: real Google Maps picker for manual pin-drop. Without this,
# CaptureScreen falls back to a plain lat/lng entry form. ---
VITE_GOOGLE_MAPS_API_KEY=
