  },
  "severityWord.3": {
    "sourceHash": "5c42afc7a23018d3",
    "text": "ਦਰਮਿਆਨਾ"
  },
  "severityWord.4": {
    "sourceHash": "c4ebc6d4a5832cd9",
    "text": "ਉੱਚ"
  },
  "severityWord.5": {
    "sourceHash": "aa93f64a309c41c2",
    "text": "ਗੰਭੀਰ"
  }
