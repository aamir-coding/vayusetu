  "result.stepAnalysed": {
    "sourceHash": "a9f96525be5c733a",
    "text": "विश्लेषण करून तुम्हाला सल्ला पाठवण्यात आला आहे."
  },
  "result.stepOfficials": {
    "sourceHash": "2b47144e8421f7d6",
