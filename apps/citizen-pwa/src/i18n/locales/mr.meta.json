  "tour.welcomeTitle": {
    "sourceHash": "7f6a521bdadaacaf",
    "text": "वायूसेतूमध्ये आपले स्वागत आहे"
  },
  "tour.welcomeBody": {
    "sourceHash": "cb505c101be673fe",
    "text": "धूर, धूळ किंवा जळणारा ढिगारा दिसला का? एका मिनिटाच्या आत याची माहिती द्या, आणि त्या भागातील जबाबदार अधिकाऱ्याला कळवले जाईल. ते कसे ते येथे दिले आहे."
  },
  "tour.photoTitle": {
    "sourceHash": "3f0b88cfa24df0bc",
    "text": "त्याचा फोटो काढा"
  },
  "tour.photoBody": {
    "sourceHash": "32af84a79733aa1d",
    "text": "जे दिसत आहे त्याचा फोटो काढा, किंवा तुम्ही आधीच काढलेला फोटो निवडा. फोटो जेवढा स्पष्ट असेल, तेवढे चांगले."
  },
  "tour.voiceTitle": {
    "sourceHash": "f650705c64e2769b",
    "text": "म्हणा (ऐच्छिक)"
  },
  "tour.voiceBody": {
    "sourceHash": "405907166f7cc10b",
    "text": "तुमच्या स्वतःच्या भाषेत एक छोटी व्हॉइस नोट जोडा: काय जळत आहे, किती वेळ झाला आहे."
  },
  "tour.locationTitle": {
    "sourceHash": "26dc5e5265eddbbc",
    "text": "ते कुठे आहे?"
  },
  "tour.locationBody": {
    "sourceHash": "4ae6882009c4d992",
    "text": "तुमच्या स्थानावरून आम्हाला कळते की हा कोणाचा परिसर आहे. जीपीएस बंद असल्यास, 'बदला' वर टॅप करून ते टाइप करा."
  },
  "tour.sendTitle": {
    "sourceHash": "f6f4688ff23d50c6",
    "text": "पाठवा"
  },
  "tour.sendBody": {
    "sourceHash": "fbb7c85a570fb79f",
    "text": "काही सेकंदात तुम्हाला दिसेल की आम्हाला काय आढळले आणि सुरक्षित राहण्यासाठीचा सल्ला, जो तुम्ही ऐकूही शकता."
  },
  "tour.reportsTitle": {
    "sourceHash": "5ddbbbc2f37428e8",
    "text": "तुमच्या अहवालांचा मागोवा घ्या"
  },
  "tour.reportsBody": {
    "sourceHash": "81e94cb572d58f0b",
    "text": "तुम्ही पाठवलेला प्रत्येक अहवाल, त्याच्या निकालासह आणि अधिकाऱ्यांनी विचारलेल्या कोणत्याही माहितीसह येथे उपलब्ध आहे."
  },
  "tour.helpTitle": {
    "sourceHash": "906ff3e577702605",
    "text": "हे पुन्हा पाहिजे का?"
  },
  "tour.helpBody": {
    "sourceHash": "22fb9fd98aa23b8a",
    "text": "मार्गदर्शिका पुन्हा पाहण्यासाठी कधीही हे बटण टॅप करा."
  }
}
