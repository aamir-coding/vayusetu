  },
  "result.stepReview": {
    "sourceHash": "d8af14777327f9da",
    "text": "एक अधिकारी अधिक बारकाईने तपासणी करतील, कारण तुमचा फोटो आणि जवळपासचे सेन्सर्स यांच्यात विसंगती आहे."
  },
  "result.stepFollow": {
    "sourceHash": "3c667a872480c481",
    "text": "'माय रिपोर्ट्स' अंतर्गत काय घडते ते फॉलो करा."
  },
  "result.slowHint": {
    "sourceHash": "815eddcca2f08335",
    "text": "नेहमीपेक्षा जास्त वेळ लागत आहे. तुमचा अहवाल जतन केला गेला आहे आणि त्याचे विश्लेषण केले जाईल; तुम्ही ही स्क्रीन सोडून नंतर 'माझे अहवाल' तपासू शकता."
  },
