{
  "name": "vayusetu",
  "version": "0.1.0",
  "private": true,
  "description": "VayuSetu \u2014 Federated AI-powered air-quality early-warning platform for hyperlocal pollution detection and forecasting (Google Cloud Hackathon, Track B: Clean Air & Climate Resilience).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build --concurrency=3",
    "dev": "turbo run dev",
    "lint": "turbo run lint --concurrency=3",
    "lint:fix": "turbo run lint -- --fix",
    "type-check": "turbo run type-check --concurrency=3",
    "test": "turbo run test --concurrency=2",
    "test:watch": "turbo run test -- --watch",
    "clean": "turbo run clean && rimraf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist apps/*/.turbo packages/*/.turbo .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-unknown"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "@types/node": "^22.7.5"
  },
  "pnpm": {
    "overrides": {
      "undici@>=6.0.0 <6.28.1": "^6.28.1",
      "fast-uri@<3.1.8": "^3.1.8",
      "fast-uri@>=4.0.0 <4.1.5": "^4.1.5"
    }
  }
}
