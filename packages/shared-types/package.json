{
  "name": "@vayusetu/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical, single-source-of-truth TypeScript contracts shared across every VayuSetu app, service, and ingestion job (PRD Section 4.1). No app or service redefines a shared entity shape.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests in shared-types\" && exit 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.13.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0"
  }
}