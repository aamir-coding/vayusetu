{
  "name": "@vayusetu/ui-components",
  "version": "0.1.0",
  "private": true,
  "description": "Shared shadcn/ui-style component library for the Citizen PWA and Admin Dashboard. Consumed directly from src via the root tsconfig path alias + vite-tsconfig-paths — there is no build step in the current architecture, so main/types point straight at source.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "type-check": "tsc -p tsconfig.json",
    "test": "echo \"no tests in ui-components yet\" && exit 0",
    "clean": "rimraf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@vayusetu/shared-types": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.445.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
