{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "@vayusetu/shared-types": ["./packages/shared-types/src/index.ts"],
      "@vayusetu/shared-types/*": ["./packages/shared-types/src/*"],
      "@vayusetu/gcp-clients": ["./packages/gcp-clients/src/index.ts"],
      "@vayusetu/gcp-clients/*": ["./packages/gcp-clients/src/*"],
      "@vayusetu/gemini-client": ["./packages/gemini-client/src/index.ts"],
      "@vayusetu/gemini-client/*": ["./packages/gemini-client/src/*"],
      "@vayusetu/h3-utils": ["./packages/h3-utils/src/index.ts"],
      "@vayusetu/h3-utils/*": ["./packages/h3-utils/src/*"],
      "@vayusetu/ui-components": ["./packages/ui-components/src/index.ts"],
      "@vayusetu/ui-components/*": ["./packages/ui-components/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo", ".next", "coverage"]
}
